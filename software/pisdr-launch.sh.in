#!/usr/bin/env bash
# Generated by install.sh as pisdr-launch.sh. Started by the desktop compositor at login.
# Waits for the RTL-SDR to enumerate, then runs PiSDR full screen; output goes to a log.
LOG="$HOME/.config/pisdr/autostart.log"
mkdir -p "$HOME/.config/pisdr"
exec >>"$LOG" 2>&1
echo "=== $(date) pisdr-launch"

# Give USB and the audio server a few seconds after login.
for i in $(seq 1 10); do
  lsusb 2>/dev/null | grep -qi "0bda:2838" && break
  sleep 1
done

cd "@SOFTWARE_DIR@" || exit 1
exec python3 -m pisdr
