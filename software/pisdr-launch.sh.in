#!/usr/bin/env bash
# Generated by install.sh as pisdr-launch.sh. Started by the desktop compositor at login.
# Waits for the RTL-SDR dongles to enumerate, then runs PiSDR full screen; output goes to a log.
LOG="$HOME/.config/pisdr/autostart.log"
mkdir -p "$HOME/.config/pisdr"
exec >>"$LOG" 2>&1
echo "=== $(date) pisdr-launch"

# Give USB and the audio server a few seconds after login. PiSDR decides which dongle does
# what when it starts, so wait for both: up to 10 s, or 5 s once one of them is there.
for i in $(seq 1 10); do
  n="$(lsusb 2>/dev/null | grep -ci "0bda:283[28]")"
  [ "$n" -ge 2 ] && break
  [ "$n" -ge 1 ] && [ "$i" -gt 5 ] && break
  sleep 1
done

cd "@SOFTWARE_DIR@" || exit 1
exec python3 -m pisdr
